---
import Base from '../layouts/Base.astro';
import WordCloud from '../components/WordCloud.astro';
import {
  profile,
  story,
  belief,
  howIWork,
  careers,
  skills,
  keywords,
} from '../data/profile';
import { products } from '../data/products';
import { contact, links } from '../data/site';

const toc = [
  { id: 'about', label: 'About' },
  { id: 'career', label: 'Experience' },
  { id: 'products', label: 'Works' },
  { id: 'how', label: 'How I Work' },
  { id: 'interests', label: 'Interests' },
  { id: 'skills', label: 'Skills' },
  { id: 'contact', label: 'Contact' },
];
---

<Base title="소개" description={profile.intro} wide>
  <div class="layout">
    <aside class="side">
      <nav aria-label="목차">
        <p class="toc-title">Contents</p>
        <ul>
          {
            toc.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>

    <div class="content">
      <header class="head">
        <h1>{profile.name}</h1>
        {profile.intro && <p class="intro">{profile.intro}</p>}
      </header>

      {
        (story.length > 0 || belief.headline) && (
          <section id="about" class="story">
            <h2>About</h2>
            {belief.headline && <p class="headline">{belief.headline}</p>}
            {belief.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {story.map((paragraph) => (
              <p class="fact">{paragraph}</p>
            ))}
          </section>
        )
      }

      {
        careers.length > 0 && (
          <section id="career">
            <h2>Experience</h2>
            <ol class="careers">
              {careers.map((career) => (
                <li>
                  <p class="company">{career.company}</p>
                  <p class="meta">
                    {career.period} · {career.role}
                  </p>
                  <p class="summary">{career.summary}</p>
                  <ul>
                    {career.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <section id="products">
        <h2>Works</h2>
        <ul class="products">
          {
            products.map((product) => (
              <li>
                <a href={`/products/${product.slug}`}>{product.name}</a>
                <span class="desc">{product.summary}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        howIWork.length > 0 && (
          <section id="how">
            <h2>How I Work</h2>
            <dl class="how">
              {howIWork.map((item) => (
                <div>
                  <dt>{item.title}</dt>
                  <dd>{item.body}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        keywords.length > 0 && (
          <section id="interests">
            <h2>Interests</h2>
            <WordCloud keywords={keywords} />
          </section>
        )
      }

      {
        skills.length > 0 && (
          <section id="skills">
            <h2>Skills</h2>
            <div class="skills">
              {skills.map((group) => (
                <div class="group">
                  <p class="label">{group.label}</p>
                  <ul class="chips">
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <section id="contact">
        <h2>Contact</h2>
        <ul class="links">
          {
            links.map((link) => (
              <li>
                <a href={link.href} rel="me noopener" target="_blank">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        </ul>
      </section>
    </div>
  </div>
</Base>

<script>
  const tocLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.side a'),
  );

  const setActive = (id: string) => {
    tocLinks.forEach((link) => {
      link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (visible) setActive(visible.target.id);
    },
    { rootMargin: '-15% 0px -70% 0px' },
  );

  tocLinks.forEach((link) => {
    const target = document.querySelector(link.getAttribute('href') ?? '');
    if (target) observer.observe(target);
  });
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, var(--content-width));
    gap: var(--gap-lg);
    justify-content: center;
  }

  /* 목차 */
  .side {
    position: sticky;
    top: var(--gap-md);
    align-self: start;
    font-size: var(--size-sm);
  }

  .toc-title {
    color: var(--text-soft);
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-bottom: var(--gap-xs);
  }

  .side ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .side a {
    display: block;
    padding: 0.35rem 0 0.35rem var(--gap-sm);
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--text-soft);
    text-decoration: none;
  }

  .side a:hover {
    color: var(--text);
  }

  .side a.active {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 600;
  }

  /* 본문 */
  .head {
    margin-bottom: var(--gap-md);
  }

  h1 {
    font-size: var(--size-xl);
  }

  .intro {
    color: var(--text-soft);
    font-size: var(--size-lg);
    margin-top: var(--gap-xs);
    max-width: var(--prose-width);
  }

  /* 제목의 구분선은 전체 폭으로 두고, 읽는 글만 좁게 잡는다 */
  .story p {
    max-width: var(--prose-width);
    margin-bottom: var(--gap-sm);
  }

  /* 한 줄 선언 */
  .story .headline {
    font-size: var(--size-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  /* 경력 사실 요약은 선언보다 뒤로 물린다 */
  .story .fact {
    color: var(--text-soft);
    font-size: var(--size-sm);
  }

  section {
    scroll-margin-top: var(--gap-md);
  }

  section + section {
    margin-top: var(--gap-lg);
  }

  h2 {
    font-size: var(--size-sm);
    color: var(--text-soft);
    font-weight: 600;
    letter-spacing: 0.06em;
    padding-top: var(--gap-sm);
    border-top: 1px solid var(--border);
    margin-bottom: var(--gap-sm);
  }

  ul,
  ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* 해 온 일 */
  .careers > li {
    padding: 0 0 var(--gap-md) var(--gap-sm);
    border-left: 2px solid var(--border);
  }

  .careers > li:last-child {
    padding-bottom: 0;
  }

  .company {
    font-weight: 700;
    font-size: var(--size-lg);
    line-height: 1.4;
  }

  .meta {
    color: var(--text-soft);
    font-size: var(--size-sm);
  }

  .careers .summary {
    margin: var(--gap-xs) 0;
    max-width: var(--prose-width);
  }

  .careers ul {
    list-style: disc;
    padding-left: 1.1rem;
    color: var(--text-soft);
    font-size: var(--size-sm);
    max-width: var(--prose-width);
  }

  .careers ul li {
    margin-bottom: 0.35rem;
  }

  /* 만든 것 */
  .products li {
    padding: var(--gap-xs) 0;
    border-bottom: 1px solid var(--border);
  }

  .products a {
    font-weight: 600;
    color: var(--accent);
  }

  .products .desc {
    display: block;
    color: var(--text-soft);
    font-size: var(--size-sm);
  }

  /* 일하는 방식 */
  .how {
    margin: 0;
    display: grid;
    gap: var(--gap-sm);
    max-width: var(--prose-width);
  }

  .how dt {
    font-weight: 600;
  }

  .how dd {
    margin: 0;
    color: var(--text-soft);
    font-size: var(--size-sm);
  }

  /* 쓰는 것 */
  .skills {
    display: grid;
    gap: var(--gap-sm);
  }

  /* 항목이 많아도 라벨이 밀려나지 않도록 열을 고정한다 */
  .group {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--gap-sm);
    align-items: start;
  }

  .label {
    color: var(--text-soft);
    font-size: var(--size-sm);
    padding-top: 0.3rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chips li {
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--size-sm);
    color: var(--text);
  }

  /* 연락 */
  .links {
    display: flex;
    gap: var(--gap-sm);
    flex-wrap: wrap;
  }

  .links a {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      display: none;
    }
  }
</style>
