---
import Base from '../layouts/Base.astro';
import WordCloud from '../components/WordCloud.astro';
import {
  profile,
  story,
  howIWork,
  careers,
  skills,
  keywords,
} from '../data/profile';
import { products } from '../data/products';
import { contact, links } from '../data/site';
---

<Base title="소개" description={profile.intro}>
  <header class="head">
    <h1>{profile.name}</h1>
    {profile.intro && <p class="intro">{profile.intro}</p>}
  </header>

  {
    story.length > 0 && (
      <section class="story">
        {story.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
    )
  }

  {
    careers.length > 0 && (
      <section>
        <h2>해 온 일</h2>
        <ol class="careers">
          {careers.map((career) => (
            <li>
              <p class="company">{career.company}</p>
              <p class="meta">
                {career.period} · {career.role}
              </p>
              <p class="summary">{career.summary}</p>
              <ul>
                {career.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section>
    <h2>만든 것</h2>
    <ul class="products">
      {
        products.map((product) => (
          <li>
            <a href={`/products/${product.slug}`}>{product.name}</a>
            <span class="desc">{product.summary}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    howIWork.length > 0 && (
      <section>
        <h2>일하는 방식</h2>
        <dl class="how">
          {howIWork.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd>{item.body}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    keywords.length > 0 && (
      <section>
        <h2>요즘 보는 것</h2>
        <WordCloud keywords={keywords} />
      </section>
    )
  }

  {
    skills.length > 0 && (
      <section>
        <h2>쓰는 것</h2>
        <dl class="skills">
          {skills.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>{group.items.join(', ')}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section>
    <h2>연락</h2>
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a href={link.href} rel="me noopener" target="_blank">
              {link.label}
            </a>
          </li>
        ))
      }
      <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
    </ul>
  </section>
</Base>

<style>
  .head {
    margin-bottom: var(--gap-md);
  }

  h1 {
    font-size: var(--size-xl);
  }

  .intro {
    color: var(--text-soft);
    font-size: var(--size-lg);
    margin-top: var(--gap-xs);
  }

  .story p {
    margin-bottom: var(--gap-sm);
  }

  section {
    margin-top: var(--gap-lg);
  }

  .story {
    margin-top: 0;
  }

  h2 {
    font-size: var(--size-sm);
    color: var(--text-soft);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: var(--gap-sm);
  }

  ul,
  ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .careers > li {
    padding-bottom: var(--gap-md);
  }

  .careers > li:last-child {
    padding-bottom: 0;
  }

  .company {
    font-weight: 700;
    font-size: var(--size-lg);
  }

  .meta {
    color: var(--text-soft);
    font-size: var(--size-sm);
  }

  .careers .summary {
    margin: var(--gap-xs) 0;
  }

  .careers ul {
    list-style: disc;
    padding-left: 1.1rem;
    color: var(--text-soft);
    font-size: var(--size-sm);
  }

  .careers ul li {
    margin-bottom: 0.3rem;
  }

  .products li {
    padding: var(--gap-xs) 0;
    border-bottom: 1px solid var(--border);
  }

  .products a {
    font-weight: 600;
    color: var(--accent);
  }

  .products .desc {
    display: block;
    color: var(--text-soft);
    font-size: var(--size-sm);
  }

  .how {
    margin: 0;
    display: grid;
    gap: var(--gap-sm);
  }

  .how dt {
    font-weight: 600;
  }

  .how dd {
    margin: 0;
    color: var(--text-soft);
    font-size: var(--size-sm);
  }

  .skills {
    margin: 0;
  }

  .skills div {
    display: flex;
    gap: var(--gap-sm);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
  }

  .skills dt {
    flex: 0 0 4.5rem;
    color: var(--text-soft);
    font-size: var(--size-sm);
  }

  .skills dd {
    margin: 0;
    font-size: var(--size-sm);
  }

  .links {
    display: flex;
    gap: var(--gap-sm);
    flex-wrap: wrap;
  }

  .links a {
    color: var(--accent);
  }
</style>
