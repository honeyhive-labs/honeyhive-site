---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Carousel from '../components/Carousel.astro';
import {
  featuredProducts,
  otherProducts,
  kinds,
} from '../data/products';
import { site } from '../data/site';

const guides = [
  { href: '/about', title: '소개', desc: '해 온 일과 만든 것' },
  { href: '/support', title: '문의', desc: '버그 신고와 기능 제안' },
];

const subtitle = kinds.join(' · ');
---

<Base title={site.name} description={`${subtitle}을 만듭니다.`} wide>
  <section class="hero">
    <h1>Honey Hive Labs</h1>
    <p>{subtitle}</p>
  </section>

  {
    featuredProducts.map((product) => (
      <article class="feature">
        <div class="intro">
          <Image src={product.icon} alt="" width={88} height={88} loading="eager" />
          <p class="kind">{product.kind}</p>
          <h2>{product.name}</h2>
          <p class="tagline">{product.tagline}</p>
          <p class="meta">
            {product.platform} · {product.storeUrl ? product.price : '출시 준비 중'}
          </p>
          <a class="cta" href={`/products/${product.slug}`}>
            자세히 보기
          </a>
        </div>

        {product.shots.length > 0 && (
          <Carousel slides={product.shots} label={`${product.name} 화면`} />
        )}
      </article>
    ))
  }

  {
    otherProducts.length > 0 && (
      <section class="others">
        <h2>그 밖에 만든 것</h2>
        <ul>
          {otherProducts.map((product) => (
            <li>
              <a href={`/products/${product.slug}`}>
                <Image src={product.icon} alt="" width={56} height={56} />
                <div>
                  <p class="kind">{product.kind}</p>
                  <p class="name">{product.name}</p>
                  <p class="desc">{product.summary}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="guides">
    {
      guides.map((guide) => (
        <a href={guide.href}>
          <p class="title">{guide.title}</p>
          <p class="desc">{guide.desc}</p>
        </a>
      ))
    }
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding: var(--gap-lg) 0 var(--gap-xl);
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    letter-spacing: -0.03em;
  }

  .hero p {
    color: var(--text-soft);
    font-size: var(--size-lg);
    margin-top: var(--gap-xs);
  }

  /* 크게 보여주는 제품 */
  .feature {
    background: var(--bg-soft);
    border-radius: 24px;
    padding: var(--gap-lg) var(--gap-md);
    margin-bottom: var(--gap-md);
    overflow: hidden;
  }

  .intro {
    text-align: center;
    margin-bottom: var(--gap-md);
  }

  .intro img {
    margin: 0 auto var(--gap-sm);
    border-radius: 20px;
  }

  .kind {
    color: var(--text-soft);
    font-size: var(--size-sm);
    letter-spacing: 0.04em;
  }

  .intro h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    letter-spacing: -0.02em;
    margin-top: 0.15rem;
  }

  .tagline {
    font-size: var(--size-lg);
    margin-top: var(--gap-xs);
  }

  .meta {
    color: var(--text-soft);
    font-size: var(--size-sm);
    margin-top: var(--gap-xs);
  }

  .cta {
    display: inline-block;
    margin-top: var(--gap-sm);
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    font-size: var(--size-sm);
    font-weight: 600;
  }

  .cta:hover {
    background: var(--accent);
  }

  /* 나머지 제품 */
  .others {
    margin-bottom: var(--gap-md);
  }

  .others h2 {
    font-size: var(--size-sm);
    color: var(--text-soft);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: var(--gap-sm);
  }

  .others ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--gap-sm);
  }

  .others a {
    display: flex;
    gap: var(--gap-sm);
    align-items: flex-start;
    padding: var(--gap-sm);
    border-radius: 20px;
    background: var(--bg-soft);
    text-decoration: none;
    height: 100%;
  }

  .others a:hover {
    background: var(--accent-soft);
  }

  .others img {
    border-radius: 14px;
    flex-shrink: 0;
  }

  .others .name {
    font-weight: 700;
  }

  .others .desc {
    color: var(--text-soft);
    font-size: var(--size-sm);
    margin-top: 0.15rem;
  }

  /* 안내 카드 */
  .guides {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--gap-sm);
  }

  .guides a {
    display: block;
    padding: var(--gap-md);
    border-radius: 20px;
    background: var(--bg-soft);
    text-decoration: none;
  }

  .guides a:hover {
    background: var(--accent-soft);
  }

  .title {
    font-weight: 700;
    font-size: var(--size-lg);
  }

  .guides .desc {
    color: var(--text-soft);
    font-size: var(--size-sm);
    margin-top: 0.15rem;
  }
</style>
