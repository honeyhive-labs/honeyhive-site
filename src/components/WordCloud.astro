---
import type { Keyword } from '../data/profile';

interface Props {
  keywords: Keyword[];
}

const { keywords } = Astro.props;
---

<ul class="cloud">
  {
    keywords.map((keyword) => (
      <li class={`w${keyword.weight}`}>{keyword.text}</li>
    ))
  }
</ul>

<style>
  .cloud {
    list-style: none;
    margin: 0;
    padding: var(--gap-sm) 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.3rem 0.9rem;
    line-height: 1.4;
  }

  li {
    white-space: nowrap;
  }

  .w1 {
    font-size: 0.85rem;
    color: var(--text-soft);
    opacity: 0.75;
  }

  .w2 {
    font-size: 1rem;
    color: var(--text-soft);
  }

  .w3 {
    font-size: 1.3rem;
    color: var(--text);
  }

  .w4 {
    font-size: 1.7rem;
    color: var(--accent);
    font-weight: 600;
  }

  .w5 {
    font-size: 2.2rem;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
</style>
